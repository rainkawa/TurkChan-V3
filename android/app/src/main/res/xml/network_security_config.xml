<?xml version="1.0" encoding="utf-8"?>
<!--
  Güvenlik: APK'da düz metin (HTTP) trafik KESİNLİKLE kapalıdır.
  Yalnızca HTTPS kullanılır; kullanıcı güvenilir olmayan CA yükleyemez.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
