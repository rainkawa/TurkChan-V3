<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tek tema: açık uygulama (application) ve etkinlik aynı temayı kullanır.
      windowBackground splash görselidir; uygulama açılınca MainActivity kendi
      arka planını koyu yapar.
    -->
    <style name="Theme.TurkChan" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorBackground">@color/tc_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
