{
  "name": "turkchan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TurkChan — Türkiye’nin topluluk platformu. Kendi kendine barındırılan tartışma platformu.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/db/seed.ts",
    "rank:assets": "node scripts/generate-rank-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@node-rs/argon2": "^2.0.2",
    "hono": "^4.7.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.0",
    "lucide-static": "^1.49.0",
    "omggif": "^1.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
